---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import Analytics from "@/components/Analytics.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const {
  title,
  description = "Interactive water cycle diagram with animated 4 stages: evaporation, condensation, precipitation & collection. Free educational tool with quiz for students K-12.",
  image = "/opengraph.jpg",
  noindex = false,
  bodyClass = ""
} = Astro.props;

const resolvedImageWithDomain = new URL(image, Astro.site).toString();

const makeTitle = title
  ? title + " | Water Cycle Diagram"
  : "Water Cycle Diagram: 4 Stages Interactive Animation | Free Learning Tool";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      noindex={noindex}
      twitter={{
        creator: "@watercyclediagram",
        site: "@watercyclediagram",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Water Cycle Diagram showing 4 stages: evaporation, condensation, precipitation, collection",
        },
      }}
    />

    <Analytics />
  </head>
  <body class={bodyClass}>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
