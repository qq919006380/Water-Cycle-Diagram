---
// Quiz Component
// 水循环知识测验

// Quiz数据定义在服务端
const QUIZ_DATA = [
  {
    question: 'What happens when water vapor cools in the atmosphere?',
    options: [
      'It forms clouds (Condensation)',
      'It falls as rain immediately',
      'It evaporates more',
    ],
    correctAnswer: 0,
    correctMessage: 'Correct! Water vapor condenses to form clouds.',
    incorrectMessage: 'Try again! Think about what happens when warm air rises and cools.',
  },
  {
    question: 'Which stage of the water cycle involves water falling from clouds?',
    options: ['Evaporation', 'Precipitation', 'Collection'],
    correctAnswer: 1,
    correctMessage: 'Correct! Precipitation is when water falls from clouds as rain or snow.',
    incorrectMessage: "Try again! Think about what happens when clouds get too heavy.",
  },
  {
    question: "Where does most of the water evaporation come from on Earth?",
    options: ['Rivers and lakes', 'Oceans and seas', 'Mountains'],
    correctAnswer: 1,
    correctMessage: "Correct! Oceans cover 71% of Earth's surface and provide most evaporation.",
    incorrectMessage: 'Try again! Think about which water body covers most of our planet.',
  },
];
---

<section class="quiz-section">
  <div class="quiz-content">
    <h2>Test Your Knowledge</h2>

    {QUIZ_DATA.map((quiz, quizIndex) => (
      <div
        class="quiz-question-container"
        data-quiz-index={quizIndex}
        style={quizIndex > 0 ? 'display: none;' : ''}
      >
        <p class="quiz-question-text">
          Question {quizIndex + 1}/{QUIZ_DATA.length}: {quiz.question}
        </p>
        <div class="quiz-options">
          {quiz.options.map((option, optionIndex) => (
            <button
              class="quiz-btn"
              data-answer={optionIndex}
              data-quiz={quizIndex}
              data-correct={quiz.correctAnswer}
              data-correct-msg={quiz.correctMessage}
              data-incorrect-msg={quiz.incorrectMessage}
              type="button"
            >
              {option}
            </button>
          ))}
        </div>
        <div class="quiz-result" data-quiz-result={quizIndex}></div>
      </div>
    ))}
  </div>
</section>

<script define:vars={{ totalQuestions: QUIZ_DATA.length }}>
  let currentQuizIndex = 0;

  function showQuiz(index) {
    document.querySelectorAll('.quiz-question-container').forEach((container, i) => {
      container.style.display = i === index ? 'block' : 'none';
    });
  }

  function goToNextQuestion() {
    currentQuizIndex++;
    if (currentQuizIndex < totalQuestions) {
      showQuiz(currentQuizIndex);
      // 重置下一题的状态
      const nextContainer = document.querySelector(`[data-quiz-index="${currentQuizIndex}"]`);
      if (nextContainer) {
        nextContainer.querySelectorAll('.quiz-btn').forEach(btn => {
          btn.disabled = false;
        });
        const result = nextContainer.querySelector('.quiz-result');
        if (result) {
          result.className = 'quiz-result';
          result.innerHTML = '';
        }
      }
    }
  }

  // 使goToNextQuestion全局可用
  window.goToNextQuestion = goToNextQuestion;

  function checkAnswer(button) {
    const answer = parseInt(button.dataset.answer);
    const quizIndex = parseInt(button.dataset.quiz);
    const correctAnswer = parseInt(button.dataset.correct);
    const correctMsg = button.dataset.correctMsg;
    const incorrectMsg = button.dataset.incorrectMsg;

    if (quizIndex !== currentQuizIndex) return;

    const isCorrect = answer === correctAnswer;
    const container = button.closest('.quiz-question-container');
    const resultEl = container.querySelector('.quiz-result');
    const buttons = container.querySelectorAll('.quiz-btn');

    // 禁用所有按钮
    buttons.forEach(btn => btn.disabled = true);

    if (isCorrect) {
      resultEl.className = 'quiz-result correct';

      if (currentQuizIndex < totalQuestions - 1) {
        resultEl.innerHTML = `
          <div style="margin-bottom: 20px;">${correctMsg}</div>
          <button onclick="window.goToNextQuestion()" class="next-btn" type="button">
            Continue to Next Question
          </button>
        `;
      } else {
        resultEl.innerHTML = '<div class="completion-msg">Congratulations! You completed all questions!</div>';
      }
    } else {
      resultEl.className = 'quiz-result incorrect';
      resultEl.textContent = incorrectMsg;

      // 2秒后重置
      setTimeout(() => {
        buttons.forEach(btn => btn.disabled = false);
        resultEl.className = 'quiz-result';
        resultEl.textContent = '';
      }, 2000);
    }
  }

  // 绑定事件
  document.querySelectorAll('.quiz-btn').forEach(btn => {
    btn.addEventListener('click', () => checkAnswer(btn));
  });
</script>

<style>
  .quiz-section {
    padding: 50px 0;
    margin: 40px 0;
  }

  .quiz-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .quiz-content h2 {
    color: #000000;
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .quiz-question-text {
    color: #666666;
    font-size: 18px;
    margin-bottom: 30px;
    line-height: 1.6;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .quiz-btn {
    width: 100%;
    padding: 16px 24px;
    border: 2px solid #e5e5e5;
    background: #ffffff;
    color: #000000;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    font-family: inherit;
  }

  .quiz-btn:hover:not(:disabled) {
    border-color: #000000;
    background: #fafafa;
  }

  .quiz-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .quiz-result {
    margin-top: 20px;
    padding: 16px;
    border-radius: 8px;
    font-weight: 500;
    display: none;
    font-size: 16px;
  }

  .quiz-result.correct {
    background: #f0f0f0;
    color: #000000;
    display: block;
    border: 2px solid #000000;
  }

  .quiz-result.incorrect {
    background: #f0f0f0;
    color: #666666;
    display: block;
    border: 2px solid #999999;
  }

  .quiz-result :global(.next-btn) {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .quiz-result :global(.next-btn:hover) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
  }

  .quiz-result :global(.completion-msg) {
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .quiz-content h2 {
      font-size: 24px;
    }

    .quiz-question-text {
      font-size: 16px;
    }

    .quiz-btn {
      font-size: 15px;
      padding: 14px 20px;
    }
  }

  @media (max-width: 480px) {
    .quiz-content h2 {
      font-size: 22px;
    }

    .quiz-question-text {
      font-size: 15px;
    }

    .quiz-btn {
      font-size: 14px;
      padding: 12px 18px;
    }
  }
</style>
