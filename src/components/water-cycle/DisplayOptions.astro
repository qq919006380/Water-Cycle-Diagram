---
// Display Options Component
// 控制标签显示、流动线条显示和下载功能
---

<div class="display-options">
  <div class="toggle-option">
    <label>Show Labels</label>
    <button class="toggle-switch active" id="toggleLabels" type="button" aria-pressed="true">
      <span class="sr-only">Toggle labels</span>
    </button>
  </div>
  <div class="toggle-option">
    <label>Flow Paths</label>
    <button class="toggle-switch active" id="toggleFlow" type="button" aria-pressed="true">
      <span class="sr-only">Toggle flow paths</span>
    </button>
  </div>
  <button class="download-btn" id="downloadBtn" type="button">
    Download Image
  </button>
</div>

<script>
  const toggleLabels = document.getElementById('toggleLabels');
  const toggleFlow = document.getElementById('toggleFlow');
  const downloadBtn = document.getElementById('downloadBtn');

  // 切换标签显示
  toggleLabels?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('water-cycle:toggle-labels'));
  });

  // 切换流动线条
  toggleFlow?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('water-cycle:toggle-flow'));
  });

  // 下载图片
  downloadBtn?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('water-cycle:download'));
  });

  // 监听状态变化，更新开关UI
  document.addEventListener('water-cycle:labels-changed', ((e: CustomEvent) => {
    if (toggleLabels) {
      toggleLabels.classList.toggle('active', e.detail.value);
      toggleLabels.setAttribute('aria-pressed', String(e.detail.value));
    }
  }) as EventListener);

  document.addEventListener('water-cycle:flow-changed', ((e: CustomEvent) => {
    if (toggleFlow) {
      toggleFlow.classList.toggle('active', e.detail.value);
      toggleFlow.setAttribute('aria-pressed', String(e.detail.value));
    }
  }) as EventListener);
</script>

<style>
  .display-options {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .toggle-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 15px;
    background: transparent;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    white-space: nowrap;
    min-width: fit-content;
    gap: 15px;
  }

  .toggle-option label {
    font-size: 14px;
    color: #000000;
    font-weight: 500;
  }

  .toggle-switch {
    width: 50px;
    height: 26px;
    background: #e5e5e5;
    border-radius: 13px;
    position: relative;
    cursor: pointer;
    transition: background 0.2s;
    border: none;
    padding: 0;
  }

  .toggle-switch.active {
    background: #000000;
  }

  .toggle-switch::after {
    content: '';
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: white;
    top: 2px;
    left: 2px;
    transition: left 0.2s;
  }

  .toggle-switch.active::after {
    left: 26px;
  }

  .download-btn {
    padding: 10px 15px;
    background: transparent;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    font-size: 14px;
    color: #000000;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .download-btn:hover {
    background: #f5f5f5;
    border-color: #000000;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .display-options {
      flex-direction: column;
      gap: 15px;
      align-items: stretch;
    }

    .toggle-option,
    .download-btn {
      justify-content: center;
    }
  }
</style>
