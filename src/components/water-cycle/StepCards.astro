---
// Step Cards Component
// 展示水循环四个阶段的卡片，点击可高亮对应阶段

import { STEP_DEFINITIONS } from '@/lib/water-cycle/config';
---

<div class="steps-section">
  <h2 class="steps-title">Water Cycle - 4 Stages</h2>
  <div class="steps-grid">
    {STEP_DEFINITIONS.map((step, index) => (
      <button
        class="step-card"
        data-step-id={step.id}
        type="button"
      >
        <div class="step-header">
          <div class="step-number">{index + 1}</div>
          <div class="step-name">{step.name}</div>
        </div>
        <div class="step-desc">{step.desc}</div>
      </button>
    ))}
  </div>
</div>

<script>
  // 点击卡片时触发阶段切换
  document.querySelectorAll('.step-card').forEach((card) => {
    card.addEventListener('click', () => {
      const stepId = (card as HTMLElement).dataset.stepId;
      document.dispatchEvent(
        new CustomEvent('water-cycle:set-step', { detail: { stepId } })
      );
    });
  });

  // 监听阶段变化，更新卡片激活状态
  document.addEventListener('water-cycle:step-changed', ((e: CustomEvent) => {
    const activeStepId = e.detail.stepId;

    document.querySelectorAll('.step-card').forEach((card) => {
      const cardStepId = (card as HTMLElement).dataset.stepId;
      if (cardStepId === activeStepId) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });
  }) as EventListener);
</script>

<style>
  .steps-section {
    width: 100%;
    padding: 30px 0;
    max-width: 1000px;
    margin: 0 auto;
  }

  .steps-title {
    color: #000000;
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 20px;
    text-align: center;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
  }

  .step-card {
    background: #fff;
    border: 1px solid #e1e8ed;
    padding: 20px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    text-align: left;
    position: relative;
    overflow: hidden;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .step-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    border-color: #3498db;
  }

  .step-card.active {
    border: 2px solid #3498db;
    background: #f0f7fc;
  }

  .step-card.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 4px;
    width: 100%;
    background: #3498db;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .step-number {
    background: #eceff1;
    color: #546e7a;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    text-align: center;
    line-height: 28px;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-card.active .step-number {
    background: #3498db;
    color: white;
  }

  .step-name {
    font-size: 16px;
    font-weight: 700;
    color: #2c3e50;
  }

  .step-desc {
    font-size: 13px;
    color: #78909c;
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .steps-title {
      font-size: 20px;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 480px) {
    .steps-title {
      font-size: 18px;
      margin-bottom: 15px;
    }

    .steps-section {
      padding: 20px 0;
    }

    .step-card {
      padding: 12px;
    }

    .step-name {
      font-size: 14px;
    }

    .step-desc {
      font-size: 13px;
    }
  }
</style>
