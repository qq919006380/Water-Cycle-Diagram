---
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Water Cycle",
    path: "#",
    children: [
      { title: "For Kids", path: "/blog/water-cycle-for-kids" },
      { title: "Class 5", path: "/blog/water-cycle-class-5" },
      { title: "Class 7", path: "/blog/water-cycle-class-7" },
    ],
  },
  {
    title: "Icebreaker Questions",
    path: "/icebreaker-questions-for-work",
  },
  {
    title: "Blog",
    path: "/blog",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-lg">
          <img src="/favicon.png" alt="Water Cycle Logo" class="w-8 h-8" />
          <span class="font-bold text-slate-800">Water Cycle</span>
          <span class="text-slate-500">Diagram</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</Container>
