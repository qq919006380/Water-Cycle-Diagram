      font-size: 18px;
    }

    .controls-section {
      padding: 20px 0;
    }

    .step-card {
      padding: 12px;
    }

    .step-name {
      font-size: 14px;
    }

    .step-desc {
      font-size: 13px;
    }

    .quiz-section h2 {
      font-size: 22px;
    }

    .quiz-question-text {
      font-size: 15px;
    }

    .quiz-option {
      font-size: 14px;
      padding: 12px 16px;
    }

    .deep-dive-section {
      padding: 40px 0;
    }

    .deep-dive-section h2 {
      font-size: 22px;
      margin-bottom: 30px;
    }

    .stage-article {
      padding: 20px;
      margin-bottom: 16px;
    }

    .stage-article h3 {
      font-size: 17px;
    }

    .stage-article p {
      font-size: 14px;
    }
  }
</style>
