---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Terms of Service"
  description="Terms of Service for Water Cycle Diagram - Understand the terms and conditions for using our educational platform."
>
  <Container>
    <div class="flex flex-col gap-8 mx-auto max-w-4xl py-16">
      <!-- 返回首页链接 -->
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Home
        </a>
      </div>

      <!-- 页面标题 -->
      <div class="border-b pb-6">
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-800 mb-4">
          Terms of Service
        </h1>
        <p class="text-slate-500">
          Last updated: December 10, 2025
        </p>
      </div>

      <!-- Agreement to Terms -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Agreement to Terms
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          Welcome to Water Cycle Diagram. These Terms of Service ("Terms") govern your access to and use of our website, services, and educational content. By accessing or using Water Cycle Diagram, you agree to be bound by these Terms.
        </p>
        <p class="text-lg leading-relaxed text-slate-600">
          If you do not agree to these Terms, you may not access or use our website. We reserve the right to modify these Terms at any time, and your continued use of the website constitutes acceptance of any changes.
        </p>
      </section>

      <!-- Educational Purpose -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Educational Purpose
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          Water Cycle Diagram is an educational platform designed to help students, teachers, and anyone interested in learning about the water cycle. Our interactive diagrams and content are provided for informational and educational purposes only.
        </p>
        <p class="text-lg leading-relaxed text-slate-600">
          While we strive for accuracy, the content should be used as a learning supplement and not as the sole source of information for academic or professional purposes. We encourage users to verify information through multiple sources.
        </p>
      </section>

      <!-- Acceptable Use -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Acceptable Use
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          You may use Water Cycle Diagram for lawful educational purposes. Acceptable uses include:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>Personal learning and education</li>
          <li>Classroom teaching and instruction</li>
          <li>Educational research and study</li>
          <li>Sharing our content with proper attribution</li>
          <li>Using our interactive tools for educational demonstrations</li>
        </ul>
      </section>

      <!-- Prohibited Activities -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Prohibited Activities
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          When using our website, you agree not to:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>Violate any applicable laws or regulations</li>
          <li>Infringe on intellectual property rights</li>
          <li>Attempt to gain unauthorized access to our systems</li>
          <li>Distribute malware, viruses, or harmful code</li>
          <li>Scrape, crawl, or use automated tools to access content without permission</li>
          <li>Impersonate others or provide false information</li>
          <li>Interfere with or disrupt the website's functionality</li>
          <li>Use the website for commercial purposes without authorization</li>
          <li>Remove or modify any copyright or proprietary notices</li>
        </ul>
      </section>

      <!-- Intellectual Property -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Intellectual Property
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          All content on Water Cycle Diagram, including but not limited to text, graphics, logos, images, animations, and interactive features, is the property of Water Cycle Diagram or its content suppliers and is protected by copyright and other intellectual property laws.
        </p>
        <p class="text-lg leading-relaxed text-slate-600">
          You may view, download, and print content for personal, non-commercial educational use only. Any other use, including reproduction, modification, distribution, or republication without prior written consent, is strictly prohibited.
        </p>
        <p class="text-lg leading-relaxed text-slate-600">
          If you wish to use our content beyond personal educational use, please contact us for permission.
        </p>
      </section>

      <!-- Disclaimer of Warranties -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Disclaimer of Warranties
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          Water Cycle Diagram is provided on an "as is" and "as available" basis without warranties of any kind, either express or implied, including but not limited to:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>Warranties of merchantability or fitness for a particular purpose</li>
          <li>Warranties that the website will be uninterrupted, error-free, or secure</li>
          <li>Warranties regarding the accuracy, reliability, or completeness of content</li>
          <li>Warranties that defects will be corrected</li>
        </ul>
        <p class="text-lg leading-relaxed text-slate-600">
          We do not guarantee that the website will meet your requirements or that it will be suitable for any specific purpose.
        </p>
      </section>

      <!-- Limitation of Liability -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Limitation of Liability
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          To the fullest extent permitted by law, Water Cycle Diagram and its operators, employees, and partners shall not be liable for any indirect, incidental, special, consequential, or punitive damages, including but not limited to:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>Loss of profits, data, or use</li>
          <li>Loss of educational opportunities</li>
          <li>Business interruption</li>
          <li>Personal injury or property damage</li>
        </ul>
        <p class="text-lg leading-relaxed text-slate-600">
          This applies even if we have been advised of the possibility of such damages. Your sole remedy for dissatisfaction with the website is to stop using it.
        </p>
      </section>

      <!-- Educational Content Accuracy -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Educational Content Accuracy
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          We make every effort to ensure the accuracy and quality of our educational content. However, scientific understanding evolves, and errors may occur. We do not warrant that:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>All information is completely accurate or up-to-date</li>
          <li>The content meets specific academic standards or curricula</li>
          <li>The educational materials are suitable for all learning levels</li>
        </ul>
        <p class="text-lg leading-relaxed text-slate-600">
          Users should verify important information through authoritative sources and consult with qualified educators or professionals when needed.
        </p>
      </section>

      <!-- Third-Party Links -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Third-Party Links
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          Our website may contain links to third-party websites or resources. These links are provided for your convenience and information only. We do not endorse, control, or assume responsibility for:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>The content, accuracy, or opinions expressed on third-party sites</li>
          <li>Privacy practices or terms of use of third-party sites</li>
          <li>Any products, services, or information offered by third parties</li>
        </ul>
        <p class="text-lg leading-relaxed text-slate-600">
          Your use of third-party websites is at your own risk and subject to their terms and conditions.
        </p>
      </section>

      <!-- Changes to Terms -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Changes to Terms
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          We reserve the right to modify these Terms at any time. When we make changes, we will update the "Last updated" date at the top of this page. Material changes will be communicated through:
        </p>
        <ul class="list-disc ml-8 space-y-2 text-slate-600">
          <li>A notice on our website homepage</li>
          <li>Email notification if you have provided contact information</li>
        </ul>
        <p class="text-lg leading-relaxed text-slate-600">
          Your continued use of the website after changes are posted constitutes acceptance of the modified Terms. If you do not agree to the changes, you must stop using the website.
        </p>
      </section>

      <!-- Contact Information -->
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-gray-800">
          Contact Information
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          If you have questions, concerns, or feedback regarding these Terms of Service, please contact us:
        </p>
        <div class="ml-6 space-y-2 text-slate-600">
          <p><strong>Website:</strong> <a href="/" class="text-blue-600 hover:underline">watercyclediagram.com</a></p>
          <p><strong>Email:</strong> <a href="mailto:support@watercyclediagram.com" class="text-blue-600 hover:underline">support@watercyclediagram.com</a></p>
        </div>
        <p class="text-lg leading-relaxed text-slate-600">
          We welcome your feedback and will address your inquiries promptly.
        </p>
      </section>

      <!-- Governing Law -->
      <section class="flex flex-col gap-4 border-t pt-6">
        <h2 class="text-2xl font-bold text-gray-800">
          Governing Law
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">
          These Terms shall be governed by and construed in accordance with applicable international laws and regulations regarding educational content and online services. Any disputes arising from these Terms or your use of the website shall be resolved through good faith negotiation first.
        </p>
        <p class="text-lg leading-relaxed text-slate-600">
          If a dispute cannot be resolved amicably, it shall be subject to the jurisdiction of the appropriate courts, with venue determined by the location of the parties involved.
        </p>
        <p class="text-lg leading-relaxed text-slate-600">
          By using Water Cycle Diagram, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service.
        </p>
      </section>
    </div>
  </Container>
</Layout>
