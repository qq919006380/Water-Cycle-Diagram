---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";

// SEO metadata
const pageTitle = "200+ Icebreaker Questions for Work: Team Building Guide";
const pageDescription = "Icebreaker questions for work that actually work! 200+ team meeting questions organized by category. Perfect for remote teams, onboarding, and daily standups.";

// 问题数据 - 7个分类，每个25-30题，共200+
const questionCategories = {
